{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "sourceMap": true,
    "outDir": "dist",
    "module": "nodenext",
    "types": ["node"],
    "rootDir": "src",
    "sourceMap": true,
    "moduleResolution": "nodenext",
    "tsBuildInfoFile": "dist/tsconfig.app.tsbuildinfo",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "target": "es2021",
    "strictPropertyInitialization": false,
    "baseUrl": "./",
    "paths": {
      "#LocalProject/Dtos": ["src/dto/index.ts"],
      "#LocalProject/Services/*": ["src/service/*"],
      "#LocalProject/Entities": ["src/db/mysql/entity/index.ts"],
      "#LocalProject/SqliteEntities": ["src/db/sqlite/entity/index.ts"],
      "#LocalProject/Utils/*": ["src/util/*"],
      "#LocalProject/Exceptions": ["src/util/exceptions/index.ts"],
      "#LocalProject/Managers/*": ["src/manager/*"],
      "#LocalProject/Auth/*": ["src/auth/*"],
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "out-tsc",
    "dist",
    "jest.config.ts",
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "eslint.config.js",
    "eslint.config.cjs",
    "eslint.config.mjs"
  ],
  "references": [
    {
      "path": "../../libs/common/tsconfig.lib.json"
    }
  ]
}
