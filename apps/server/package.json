{
  "name": "@here-to-translate/server",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "targets": {
      "build": {
        "executor": "@nx/webpack:webpack",
        "outputs": [
          "{options.outputPath}"
        ],
        "options": {
          "outputPath": "dist/apps/server",
          "main": "apps/server/src/main.ts",
          "tsConfig": "apps/server/tsconfig.app.json",
          "webpackConfig": "apps/server/webpack.config.cjs"
        },
        "configurations": {
          "production": {
            "optimization": true,
            "sourceMap": false,
            "extractLicenses": true
          },
          "development": {
            "sourceMap": true,
            "optimization": false
          }
        }
      },
      "serve": {
        "executor": "@nx/js:node",
        "defaultConfiguration": "development",
        "dependsOn": [
          "build"
        ],
        "options": {
          "buildTarget": "@here-to-translate/server:build",
          "runBuildTargetDependencies": false
        },
        "configurations": {
          "development": {
            "args": [
              "node-options=--experimental-require-module"
            ],
            "buildTarget": "@here-to-translate/server:build:development"
          },
          "production": {
            "args": [
              "node-options=--experimental-require-module"
            ],
            "buildTarget": "@here-to-translate/server:build:production"
          }
        }
      },
      "test": {
        "executor": "@nx/jest:jest",
        "outputs": [
          "{projectRoot}/coverage"
        ],
        "options": {
          "jestConfig": "apps/server/jest.config.js",
          "passWithNoTests": true
        }
      },
      "migration:generate": {
        "executor": "@nx/js:node",
        "options": {
          "buildTarget": "@here-to-translate/server:build",
          "script": "node dist/apps/server/migration-generate.js"
        }
      },
      "migration:run": {
        "executor": "@nx/js:node",
        "options": {
          "buildTarget": "@here-to-translate/server:build",
          "script": "node dist/apps/server/migration-run.js"
        }
      }
    },
    "dependencies": {
      "@here-to-translate/common": "^0.0.1",
      "date-fns": "^4.1.0",
      "docx": "^9.5.1",
      "docx-parser": "^0.2.1",
      "openai": "^5.10.2",
      "pdf-lib": "^1.17.1",
      "pdf-parse": "^1.1.1",
      "socket.io": "^4.8.1",
      "socket.io-client": "^4.8.1"
    }
  },
  "dependencies": {
    "@prometeia/pdfassembler": "^0.1.0-beta.8.fix1",
    "docx": "^9.5.1",
    "jszip": "^3.10.1",
    "mammoth": "^1.6.0",
    "pdf-lib": "^1.17.1",
    "xliff": "^6.2.2"
  },
  "devDependencies": {
    "tsx": "^4.20.3"
  }
}
